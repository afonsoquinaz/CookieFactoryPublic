; Engine configuration file.
config_version=5

[application]

config/name="Cookie Factory"
config/description="Grow a tiny chocolate-cookie workshop into a cookie empire."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=60
boot_splash/bg_color=Color(0.99, 0.86, 0.68, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

Game="*res://autoload/game.gd"
Sfx="*res://autoload/sfx.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[gui]

theme/custom_font="res://assets/fonts/Fredoka-SemiBold.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
